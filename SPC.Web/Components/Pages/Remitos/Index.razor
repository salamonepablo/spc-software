@page "/delivery-notes"
@page "/remitos"
@using SPC.Web.Services
@using SPC.Web.Services.Models
@inject IApiService Api
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Remitos - SPC</PageTitle>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3"><h3>Remitos</h3><a class="btn btn-primary" href="/delivery-notes/new">Nuevo remito</a></div>
    <div class="card mb-3"><div class="card-body d-flex gap-2">
        <input class="form-control" placeholder="Buscar por número o cliente" @bind="search" @bind:event="oninput" />
        <button class="btn btn-outline-primary" @onclick="Search">Buscar</button>
    </div></div>
    @if (loading) { <p>Cargando remitos...</p> }
    else if (result?.Items.Count is not > 0) { <div class="alert alert-info">No se encontraron remitos.</div> }
    else {
        <table class="table table-striped"><thead><tr><th>Número</th><th>Fecha</th><th>Cliente</th><th>Factura</th><th></th></tr></thead><tbody>
        @foreach (var note in result.Items) { <tr><td>@note.DeliveryNoteNumber</td><td>@note.DeliveryNoteDate.ToString("dd/MM/yyyy")</td><td>@note.CustomerName</td><td>@(note.InvoiceNumber?.ToString() ?? "-")</td><td><a class="btn btn-sm btn-outline-primary" href="/delivery-notes/@note.Id">Ver</a></td></tr> }
        </tbody></table>
        <div class="d-flex justify-content-between"><span>@result.TotalCount remitos</span><div><button class="btn btn-outline-secondary me-2" disabled="@(page <= 1)" @onclick="Previous">Anterior</button><button class="btn btn-outline-secondary" disabled="@(page * pageSize >= result.TotalCount)" @onclick="Next">Siguiente</button></div></div>
    }
</div>
@code {
    private DeliveryNoteSearchResultDto? result;
    private string search = "";
    private int page = 1;
    private const int pageSize = 20;
    private bool loading = true;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { loading = true; result = await Api.SearchDeliveryNotesAsync(new() { Page = page, PageSize = pageSize, Search = search }); loading = false; }
    private async Task Search() { page = 1; await Load(); }
    private async Task Previous() { if (page > 1) { page--; await Load(); } }
    private async Task Next() { if (result != null && page * pageSize < result.TotalCount) { page++; await Load(); } }
}
