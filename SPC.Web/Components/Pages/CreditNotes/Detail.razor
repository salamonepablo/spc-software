@page "/credit-notes/{CreditNoteNumber:long}"
@page "/credit-notes/{VoucherType}/{CreditNoteNumber:long}"
@page "/credit-notes/{VoucherType}/{PointOfSale:int}/{CreditNoteNumber:long}"
@page "/notas-credito/{CreditNoteNumber:long}"
@using SPC.Web.Services
@using SPC.Web.Services.Models
@inject IApiService Api
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Credit Note Detail - SPC</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Credit Note @CreditNoteNumber</h3>
        <button class="btn btn-outline-secondary" @onclick="GoBack">Volver</button>
    </div>

    @if (loading)
    {
        <LoadingSpinner Message="Cargando detalle de nota de credito..." />
    }
    else if (creditNote == null)
    {
        <div class="alert alert-warning">
            No se encontro la nota de credito solicitada.
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Cliente:</strong> @creditNote.CustomerName</p>
                        <p class="mb-1"><strong>CUIT:</strong> @(creditNote.CustomerCUIT ?? "-")</p>
                        <p class="mb-1"><strong>Comprobante:</strong> NC @creditNote.VoucherType @creditNote.PointOfSale.ToString("D4")-@creditNote.CreditNoteNumber.ToString("D8")</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-1"><strong>Fecha:</strong> @creditNote.CreditNoteDate.ToString("dd/MM/yyyy")</p>
                        <p class="mb-1"><strong>Total:</strong> <span class="text-nowrap">@creditNote.Total.ToString("C2")</span></p>
                        @if (creditNote.IsVoided)
                        {
                            <span class="badge bg-danger">Anulada</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Items</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in creditNote.Details)
                            {
                                <tr>
                                    <td>@detail.ItemNumber</td>
                                    <td><code>@detail.ProductCode</code></td>
                                    <td>@detail.ProductDescription</td>
                                    <td class="text-end">@detail.Quantity.ToString("N2")</td>
                                    <td class="text-end text-nowrap">@detail.UnitPrice.ToString("C2")</td>
                                    <td class="text-end text-nowrap">@detail.Subtotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end"><strong>Subtotal:</strong></td>
                                <td class="text-end text-nowrap">@creditNote.Subtotal.ToString("C2")</td>
                            </tr>
                            @if (creditNote.VATAmount > 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-end">IVA:</td>
                                    <td class="text-end text-nowrap">@creditNote.VATAmount.ToString("C2")</td>
                                </tr>
                            }
                            @if (creditNote.IIBBAmount > 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-end">Percepción IIBB:</td>
                                    <td class="text-end text-nowrap">@creditNote.IIBBAmount.ToString("C2")</td>
                                </tr>
                            }
                            @if (creditNote.DiscountAmount > 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-end">Descuento:</td>
                                    <td class="text-end text-danger text-nowrap">-@creditNote.DiscountAmount.ToString("C2")</td>
                                </tr>
                            }
                            <tr class="table-primary">
                                <td colspan="5" class="text-end"><strong>TOTAL:</strong></td>
                                <td class="text-end text-nowrap"><strong>@creditNote.Total.ToString("C2")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long CreditNoteNumber { get; set; }

    [Parameter]
    public string? VoucherType { get; set; }

    [Parameter]
    public int? PointOfSale { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public int? CustomerId { get; set; }

    private CreditNoteDetailDto? creditNote;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;

        try
        {
            creditNote = await Api.GetCreditNoteByNumberAsync(CreditNoteNumber, CustomerId, VoucherType, PointOfSale);
        }
        finally
        {
            loading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/current-account");
    }
}
