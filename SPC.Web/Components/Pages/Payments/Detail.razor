@page "/payments/{PaymentNumber:long}"
@page "/pagos/{PaymentNumber:long}"
@using SPC.Web.Services
@using SPC.Web.Services.Models
@inject IApiService Api
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Payment Detail - SPC</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Payment @PaymentNumber</h3>
        <button class="btn btn-outline-secondary" @onclick="GoBack">Volver</button>
    </div>

    @if (loading)
    {
        <LoadingSpinner Message="Cargando detalle de pago..." />
    }
    else if (payment == null)
    {
        <div class="alert alert-warning">
            No se encontro el pago solicitado.
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Cliente:</strong> @payment.CustomerName</p>
                        <p class="mb-1"><strong>CUIT:</strong> @(payment.CustomerCUIT ?? "-")</p>
                        <p class="mb-1"><strong>Sucursal:</strong> @payment.BranchName</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-1"><strong>Fecha:</strong> @payment.PaymentDate.ToString("dd/MM/yyyy")</p>
                        <p class="mb-1"><strong>Linea:</strong> @payment.AppliesTo</p>
                        <p class="mb-1"><strong>Total:</strong> <span class="text-nowrap">@payment.TotalAmount.ToString("C2")</span></p>
                        @if (payment.IsVoided)
                        {
                            <span class="badge bg-danger">IsVoided</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(payment.AppliesToDescription))
                {
                    <div class="mt-3">
                        <strong>Detalle:</strong>
                        <p class="text-muted mb-0">@payment.AppliesToDescription</p>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Formas de pago</strong>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in payment.Details)
                            {
                                <tr>
                                    <td>@detail.LineNumber</td>
                                    <td><code>@detail.PaymentMethodCode</code></td>
                                    <td>@detail.PaymentMethodDescription</td>
                                    <td class="text-end text-nowrap">@detail.Amount.ToString("C2")</td>
                                    <td>@(string.IsNullOrWhiteSpace(detail.Notes) ? "-" : detail.Notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long PaymentNumber { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public int? CustomerId { get; set; }

    private PaymentDetailDto? payment;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;

        try
        {
            payment = await Api.GetPaymentByNumberAsync(PaymentNumber, CustomerId);
        }
        finally
        {
            loading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/current-account");
    }
}
