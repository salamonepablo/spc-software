@page "/cuenta-corriente"
@page "/current-account"
@using SPC.Web.Services
@using SPC.Web.Services.Models
@using SPC.Web.Components.Shared
@inject IApiService Api
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Cuenta Corriente - SPC</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Cuenta Corriente</h3>
    </div>

    @* Customer selector *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Seleccionar Cliente</label>
                    <TypeaheadInput TItem="CustomerDto"
                                    SearchAsync="SearchCustomers"
                                    DisplaySelector="@(c => $"{c.Id} - {c.CompanyName}")"
                                    OnSelected="HandleCustomerSelected"
                                    Placeholder="Buscar por codigo o razon social..."
                                    MinLength="1" />
                </div>
                @if (selectedCustomer != null)
                {
                    <div class="col-md-6">
                        <div class="mt-4">
                            <strong>@selectedCustomer.CompanyName</strong>
                            @if (!string.IsNullOrEmpty(selectedCustomer.CUIT))
                            {
                                <span class="text-muted ms-2">CUIT: @selectedCustomer.CUIT</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner Message="Cargando cuenta corriente..." />
    }
    else if (selectedCustomer == null)
    {
        <div class="alert alert-info">
            Seleccione un cliente para ver su cuenta corriente.
        </div>
    }
    else if (account == null)
    {
        <div class="alert alert-warning">
            El cliente no tiene movimientos en su cuenta corriente.
        </div>
    }
    else
    {
        @* Balance cards - compact styling *@
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="card card-balance border-0 shadow-sm">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Facturación (L1)</span>
                            <span class="fw-bold @(account.BillingBalance >= 0 ? "text-success" : "text-danger")">
                                @account.BillingBalance.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-balance border-0 shadow-sm">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Presupuestos (L2)</span>
                            <span class="fw-bold @(account.BudgetBalance >= 0 ? "text-info" : "text-warning")">
                                @account.BudgetBalance.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-balance border-0 shadow-sm bg-light">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Saldo Total</span>
                            <span class="fw-bold fs-6 @(account.TotalBalance >= 0 ? "text-primary" : "text-danger")">
                                @account.TotalBalance.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Filters - compact *@
        <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Desde</label>
                        <input type="date" class="form-control form-control-sm" @bind="dateFrom" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Hasta</label>
                        <input type="date" class="form-control form-control-sm" @bind="dateTo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Línea</label>
                        <select class="form-select form-select-sm" @bind="lineFilter">
                            <option value="">Todas</option>
                            <option value="1">Facturación (L1)</option>
                            <option value="2">Presupuestos (L2)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">
                            Filtrar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* Movements table *@
        @if (movements == null || movements.Movements.Count == 0)
        {
            <div class="alert alert-info">
                No se encontraron movimientos con los filtros seleccionados.
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                    <span class="small fw-semibold">Movimientos</span>
                    <span class="text-muted small">@movements.TotalCount registros</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped table-hover mb-0 small align-middle">
                            <thead class="table-secondary">
                                <tr>
                                    <th class="py-2 text-nowrap">Fecha</th>
                                    <th class="py-2 text-nowrap">Tipo</th>
                                    <th class="py-2 text-nowrap">Número</th>
                                    <th class="py-2 text-end text-nowrap">Fact. (L1)</th>
                                    <th class="py-2 text-end text-nowrap">Ppto (L2)</th>
                                    <th class="py-2 text-end text-nowrap">Saldo L1</th>
                                    <th class="py-2 text-end text-nowrap">Saldo L2</th>
                                    <th class="py-2">Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in movements.Movements)
                                {
                                    <tr>
                                        <td class="py-1 text-nowrap">@mov.MovementDate.ToString("dd/MM/yyyy")</td>
                                        <td class="py-1">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <span class="badge badge-sm @GetDocumentTypeBadgeClass(mov.DocumentTypeCode)">
                                                    @GetCompactDocumentTypeLabel(mov)
                                                </span>
                                                @if (TryGetFiscalSubtype(mov.DocumentTypeCode, out var subtype))
                                                {
                                                    <span class="badge text-bg-light border">@subtype</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-1 text-nowrap">
                                            @if (CanOpenDocument(mov))
                                            {
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 text-decoration-none"
                                                        title="Ver documento"
                                                        @onclick="() => OpenDocument(mov)">
                                                    <code class="small">@mov.DocumentNumber</code>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 text-muted text-decoration-none"
                                                        title="@GetUnavailableDocumentHint(mov)"
                                                        disabled>
                                                    <code class="small">@mov.DocumentNumber</code>
                                                </button>
                                            }
                                        </td>
                                        <td class="py-1 text-end text-nowrap @(mov.BillingAmount < 0 ? "text-success" : mov.BillingAmount > 0 ? "text-danger" : "")">
                                            @if (mov.BillingAmount != 0)
                                            {
                                                @mov.BillingAmount.ToString("N2")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="py-1 text-end text-nowrap @(mov.BudgetAmount < 0 ? "text-success" : mov.BudgetAmount > 0 ? "text-info" : "")">
                                            @if (mov.BudgetAmount != 0)
                                            {
                                                @mov.BudgetAmount.ToString("N2")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="py-1 text-end text-nowrap fw-medium">@mov.BillingRunningBalance.ToString("N2")</td>
                                        <td class="py-1 text-end text-nowrap fw-medium">@mov.BudgetRunningBalance.ToString("N2")</td>
                                        <td class="py-1 text-truncate" style="max-width: 220px;">@(mov.Description ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="border-top bg-light px-3 py-2 text-muted small">
                        La navegacion de detalle depende del metadata de cada movimiento.
                    </div>
                </div>
                @if (movements.Movements.Count < movements.TotalCount)
                {
                    <div class="card-footer">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Mostrando @movements.Movements.Count de @movements.TotalCount</span>
                            <button class="btn btn-outline-primary" @onclick="LoadMore">
                                Cargar mas...
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private CustomerDto? selectedCustomer;
    private CurrentAccountDto? account;
    private CurrentAccountMovementsDto? movements;
    private bool loading;

    // Filters
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string lineFilter = "";
    private int pageSize = 50;
    private int currentSkip = 0;

    private async Task<List<CustomerDto>> SearchCustomers(string term)
    {
        return await Api.SearchCustomersAsync(term);
    }

    private async Task HandleCustomerSelected(CustomerDto customer)
    {
        selectedCustomer = customer;
        currentSkip = 0;
        await LoadAccountData();
    }

    private async Task LoadAccountData()
    {
        if (selectedCustomer == null) return;

        loading = true;
        try
        {
            var accountTask = Api.GetCurrentAccountAsync(selectedCustomer.Id);
            var movementsTask = Api.GetCurrentAccountMovementsAsync(
                selectedCustomer.Id,
                dateFrom,
                dateTo,
                string.IsNullOrEmpty(lineFilter) ? null : int.Parse(lineFilter),
                0,
                pageSize);

            await Task.WhenAll(accountTask, movementsTask);

            account = await accountTask;
            movements = await movementsTask;
            currentSkip = movements?.Movements.Count ?? 0;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentSkip = 0;
        await LoadAccountData();
    }

    private async Task LoadMore()
    {
        if (selectedCustomer == null || movements == null) return;

        var more = await Api.GetCurrentAccountMovementsAsync(
            selectedCustomer.Id,
            dateFrom,
            dateTo,
            string.IsNullOrEmpty(lineFilter) ? null : int.Parse(lineFilter),
            currentSkip,
            pageSize);

        if (more != null && more.Movements.Count > 0)
        {
            movements.Movements.AddRange(more.Movements);
            currentSkip += more.Movements.Count;
        }
    }

    private string GetDocumentTypeBadgeClass(int documentTypeCode)
    {
        // Billing documents (100s) - blue
        // Budget documents (120s) - teal
        // Payments (30s, 108, 122) - green
        // Credit notes - success
        // Debit notes - warning
        // Voids - danger
        return documentTypeCode switch
        {
            101 or 102 => "bg-primary",      // Invoice A/B
            103 or 104 => "bg-success",      // Credit Note A/B
            105 or 106 => "bg-warning",      // Debit Note A/B
            108 => "bg-success",             // Payment Billing
            109 => "bg-danger",              // Payment Void Billing
            20 => "bg-info",                 // Quote
            121 => "bg-danger",              // Quote Void
            122 => "bg-success",             // Payment Budget
            123 => "bg-danger",              // Payment Void Budget
            124 or 125 => "bg-warning",      // Internal Debit A/B
            30 or 31 => "bg-success",        // Payment/Receipt
            _ => "bg-secondary"
        };
    }

    private static string GetCompactDocumentTypeLabel(CurrentAccountMovementDto movement)
    {
        return movement.DocumentTypeCode switch
        {
            1 or 101 or 102 => "Fact.",
            3 or 103 or 104 => "N.C.",
            5 or 105 or 106 => "N.D.",
            7 or 124 or 125 => "N.D.I.",
            20 or 121 => "Ppto.",
            30 or 31 or 108 or 109 or 122 or 123 => "Pago",
            99 => "S.I.",
            _ => movement.DocumentType
        };
    }

    private static bool TryGetFiscalSubtype(int documentTypeCode, out string subtype)
    {
        subtype = documentTypeCode switch
        {
            101 or 103 or 105 or 124 => "A",
            102 or 104 or 106 or 125 => "B",
            _ => string.Empty
        };

        return !string.IsNullOrEmpty(subtype);
    }

    private static bool CanOpenDocument(CurrentAccountMovementDto movement)
    {
        return movement.Navigation?.CanOpen == true
            && !string.IsNullOrWhiteSpace(movement.Navigation.TargetRoute);
    }

    private void OpenDocument(CurrentAccountMovementDto movement)
    {
        var route = movement.Navigation?.TargetRoute;
        if (route != null)
        {
            Navigation.NavigateTo(route);
        }
    }

    private static string GetUnavailableDocumentHint(CurrentAccountMovementDto movement)
    {
        if (!string.IsNullOrWhiteSpace(movement.Navigation?.DisabledReason))
        {
            return movement.Navigation!.DisabledReason!;
        }

        return "No hay metadata de navegacion para este movimiento";
    }
}
