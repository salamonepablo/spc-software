@page "/cuenta-corriente"
@page "/current-account"
@using SPC.Web.Services
@using SPC.Web.Services.Models
@using SPC.Web.Components.Shared
@inject IApiService Api
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Cuenta Corriente - SPC</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Cuenta Corriente</h3>
    </div>

    @* Customer selector *@
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Seleccionar Cliente</label>
                    <TypeaheadInput TItem="CustomerDto"
                                    SearchAsync="SearchCustomers"
                                    DisplaySelector="@(c => $"{c.Id} - {c.CompanyName}")"
                                    OnSelected="HandleCustomerSelected"
                                    Placeholder="Buscar por codigo o razon social..."
                                    MinLength="1" />
                </div>
                @if (selectedCustomer != null)
                {
                    <div class="col-md-6">
                        <div class="mt-4">
                            <strong>@selectedCustomer.CompanyName</strong>
                            @if (!string.IsNullOrEmpty(selectedCustomer.CUIT))
                            {
                                <span class="text-muted ms-2">CUIT: @selectedCustomer.CUIT</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (loading)
    {
        <LoadingSpinner Message="Cargando cuenta corriente..." />
    }
    else if (selectedCustomer == null)
    {
        <div class="alert alert-info">
            Seleccione un cliente para ver su cuenta corriente.
        </div>
    }
    else if (account == null)
    {
        <div class="alert alert-warning">
            El cliente no tiene movimientos en su cuenta corriente.
        </div>
    }
    else
    {
        @* Balance cards - compact styling *@
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="card card-balance border-0 shadow-sm">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Facturación (L1)</span>
                            <span class="fw-bold @(account.BillingBalance >= 0 ? "text-success" : "text-danger")">
                                @account.BillingBalance.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-balance border-0 shadow-sm">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Presupuestos (L2)</span>
                            <span class="fw-bold @(account.BudgetBalance >= 0 ? "text-info" : "text-warning")">
                                @account.BudgetBalance.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-balance border-0 shadow-sm bg-light">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Saldo Total</span>
                            <span class="fw-bold fs-6 @(account.TotalBalance >= 0 ? "text-primary" : "text-danger")">
                                @account.TotalBalance.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Filters - compact *@
        <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Desde</label>
                        <input type="date" class="form-control form-control-sm" @bind="dateFrom" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Hasta</label>
                        <input type="date" class="form-control form-control-sm" @bind="dateTo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Línea</label>
                        <select class="form-select form-select-sm" @bind="lineFilter">
                            <option value="">Todas</option>
                            <option value="1">Facturación (L1)</option>
                            <option value="2">Presupuestos (L2)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary btn-sm w-100" @onclick="SearchMovements">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* Movements table *@
        @if (movements == null)
        {
            <div class="alert alert-info">
                Ajuste los filtros y haga clic en <strong>Buscar</strong> para cargar movimientos.
            </div>
        }
        else if (movements.Movements.Count == 0)
        {
            <div class="alert alert-info">
                No se encontraron movimientos con los filtros seleccionados.
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                    <span class="small fw-semibold">Movimientos</span>
                    <span class="text-muted small">@movements.TotalCount registros</span>
                </div>

                @* Initial balance row (saldos al inicio del período) *@
                <div class="bg-light border-bottom px-3 py-2">
                    <div class="row small">
                        <div class="col text-muted">Saldo Inicial del Período:</div>
                        <div class="col-auto text-end">
                            <span class="me-3">L1: <strong>@movements.InitialBillingBalance.ToString("N2")</strong></span>
                            <span class="me-3">L2: <strong>@movements.InitialBudgetBalance.ToString("N2")</strong></span>
                            <span>Total: <strong class="text-primary">@movements.InitialTotalBalance.ToString("N2")</strong></span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped table-hover mb-0 small align-middle">
                            <thead class="table-secondary">
                                <tr>
                                    <th class="py-2 text-nowrap">Fecha</th>
                                    <th class="py-2 text-nowrap">Tipo Doc.</th>
                                    <th class="py-2 text-nowrap">Nro. Doc.</th>
                                    <th class="py-2 text-end text-nowrap">Importe L1</th>
                                    <th class="py-2 text-end text-nowrap">Importe L2</th>
                                    <th class="py-2 text-end text-nowrap">Saldo Parcial</th>
                                    <th class="py-2">OBS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in movements.Movements)
                                {
                                    <tr>
                                        <td class="py-1 text-nowrap">@mov.MovementDate.ToString("dd/MM/yyyy")</td>
                                        <td class="py-1">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <span class="badge badge-sm @GetDocumentTypeBadgeClass(mov.DocumentTypeShortCode)"
                                                      title="@(mov.DocumentTypeTooltip ?? mov.DocumentTypeLabel)">
                                                    @mov.DocumentTypeShortCode
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(mov.DocumentTypeLabel))
                                                {
                                                    <span class="text-muted small">@mov.DocumentTypeLabel</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-1 text-nowrap">
                                            @if (CanOpenDocument(mov))
                                            {
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 text-decoration-none"
                                                        title="Ver documento"
                                                        @onclick="() => OpenDocument(mov)">
                                                    <code class="small">@mov.DocumentNumber</code>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-link btn-sm p-0 text-muted text-decoration-none"
                                                        title="@GetUnavailableDocumentHint(mov)"
                                                        disabled>
                                                    <code class="small">@mov.DocumentNumber</code>
                                                </button>
                                            }
                                        </td>
                                        <td class="py-1 text-end text-nowrap @(mov.BillingAmount < 0 ? "text-success" : mov.BillingAmount > 0 ? "text-danger" : "")">
                                            @if (mov.BillingAmount != 0)
                                            {
                                                @mov.BillingAmount.ToString("N2")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="py-1 text-end text-nowrap @(mov.BudgetAmount < 0 ? "text-success" : mov.BudgetAmount > 0 ? "text-info" : "")">
                                            @if (mov.BudgetAmount != 0)
                                            {
                                                @mov.BudgetAmount.ToString("N2")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="py-1 text-end text-nowrap fw-bold">@mov.TotalRunningBalance.ToString("N2")</td>
                                        <td class="py-1 text-truncate" style="max-width: 180px;">@(mov.Description ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Final balance row (saldos al final del período) *@
                <div class="bg-light border-top px-3 py-2">
                    <div class="row small">
                        <div class="col text-muted">Saldo Final del Período:</div>
                        <div class="col-auto text-end">
                            <span class="me-3">L1: <strong>@movements.FinalBillingBalance.ToString("N2")</strong></span>
                            <span class="me-3">L2: <strong>@movements.FinalBudgetBalance.ToString("N2")</strong></span>
                            <span>Total: <strong class="text-primary">@movements.FinalTotalBalance.ToString("N2")</strong></span>
                        </div>
                    </div>
                </div>

            </div>
        }
    }
</div>

@code {
    private CustomerDto? selectedCustomer;
    private CurrentAccountDto? account;
    private CurrentAccountMovementsDto? movements;
    private bool loading;

    // Filters
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string lineFilter = "";

    protected override void OnInitialized()
    {
        dateFrom = DateTime.Today.AddYears(-1);
        dateTo = DateTime.Today;
    }

    private async Task<List<CustomerDto>> SearchCustomers(string term)
    {
        return await Api.SearchCustomersAsync(term);
    }

    private async Task HandleCustomerSelected(CustomerDto customer)
    {
        selectedCustomer = customer;

        loading = true;
        try
        {
            account = await Api.GetCurrentAccountAsync(selectedCustomer.Id);
            movements = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchMovements()
    {
        if (selectedCustomer == null) return;
        if (!dateFrom.HasValue || !dateTo.HasValue) return;

        loading = true;
        try
        {
            account = await Api.GetCurrentAccountAsync(selectedCustomer.Id);
            movements = await Api.GetCurrentAccountMovementsByRangeAsync(
                selectedCustomer.Id,
                dateFrom.Value,
                dateTo.Value,
                string.IsNullOrEmpty(lineFilter) ? null : int.Parse(lineFilter));
        }
        finally
        {
            loading = false;
        }
    }

    private string GetDocumentTypeBadgeClass(string shortCode)
    {
        return shortCode.ToUpperInvariant() switch
        {
            "FA" or "FB" => "bg-primary",
            "NCA" or "NCB" => "bg-success",
            "NDA" or "NDB" => "bg-warning text-dark",
            "PR" => "bg-info text-dark",
            "PG" => "bg-success",
            "SI" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private static bool CanOpenDocument(CurrentAccountMovementDto movement)
    {
        return movement.Navigation?.CanOpen == true
            && !string.IsNullOrWhiteSpace(movement.Navigation.TargetRoute);
    }

    private void OpenDocument(CurrentAccountMovementDto movement)
    {
        var route = movement.Navigation?.TargetRoute;
        if (route != null)
        {
            Navigation.NavigateTo(route);
        }
    }

    private static string GetUnavailableDocumentHint(CurrentAccountMovementDto movement)
    {
        if (!string.IsNullOrWhiteSpace(movement.Navigation?.DisabledReason))
        {
            return movement.Navigation!.DisabledReason!;
        }

        return "No hay metadata de navegacion para este movimiento";
    }
}
